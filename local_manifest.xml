<?xml version="1.0" encoding="UTF-8"?>
<manifest>

<!--    <remote  name="alpha-devices"
             fetch="https://github.com/alphadroid-devices"
             sync-c="true"
             sync-j="4"
             revision="refs/heads/alpha-17.0" />-->

    <!-- ===================== device =====================
         The two OnePlus device trees are private and live on a personal
         remote, not alphadroid-devices. Their alphadroid-devices copies exist
         but trail this work, so do not measure "unpushed" against them.
         A sync needs GitHub credentials that can read private repos. -->
    <remote name="elpaablo"
            fetch="https://github.com/elpaablo/"
            revision="refs/heads/alpha-17.0" />

    <project path="device/oneplus/astonc" name="device_oneplus_astonc" remote="elpaablo" revision="alpha-17.0" />
    <project path="device/oneplus/sm8550-common" name="device_oneplus_sm8550-common" remote="elpaablo" revision="alpha-17.0" />

    <!-- ===================== platform splits =====================
         Device work lives on alpha-17.0-aston, on top of the global alpha-17.0,
         and both OnePlus devices build it (astonc adds nothing platform-side).
         frameworks/av carries the OPlus camera work there. -->

    <remove-project name="frameworks_av" />
    <project path="frameworks/av" name="frameworks_av" remote="alpha-gitlab" revision="alpha-17.0-aston" groups="pdk,sysui-studio" />

    <remove-project name="frameworks_native" />
    <project path="frameworks/native" name="frameworks_native" remote="alpha-gitlab" revision="alpha-17.0-aston" groups="pdk" />

    <remove-project name="frameworks_base" />
    <project path="frameworks/base" name="frameworks_base" remote="alpha-gitlab" revision="alpha-17.0-aston" groups="pdk-cw-fs,pdk-fs,sysui-studio" />

    <!-- vendor/alpha has no device commits: its alpha-17.0-aston equals
         alpha-17.0. vendor/addons is still LOS on A17. Pin either once it
         carries device work and its branch is pushed, or repo sync fails.

    <remove-project name="vendor_alpha" />
    <project path="vendor/alpha" name="vendor_alpha" remote="alpha-gitlab" revision="alpha-17.0-aston" />

    <remove-project name="vendor_addons" />
    <project path="vendor/addons" name="vendor_addons" remote="alpha-gitlab" revision="alpha-17.0-aston" />
    -->

    <!-- ===================== hardware =====================
         hardware/oplus and the sm8550 display HAL are per-device branches: astonc
         has the Iris 7P chip, aston does not, and MEMC/Iris work on a shared
         branch corrupted aston's display at unlock (A16, 2026-08-01). aston takes
         hardware/oplus alpha-17.0 and the LOS display HAL (alpha-17.0-caf-sm8550
         is LOS as-is). The display HAL removal must be by path: four projects
         share the name hardware_qcom_display. -->

    <project path="hardware/oplus" name="hardware_oplus" remote="alpha-gitlab" revision="alpha-17.0-astonc" />

    <remove-project name="LineageOS/android_hardware_qcom_display" path="hardware/qcom-caf/sm8550/display" />
    <project path="hardware/qcom-caf/sm8550/display" name="hardware_qcom_display" remote="alpha-gitlab" revision="alpha-17.0-caf-sm8550-astonc" groups="qcom" />


    <!-- ===================== kernel ===================== -->
    <project path="kernel/oneplus/sm8550" name="kernel_oneplus_sm8550" remote="alpha-devices" revision="alpha-17.0" />
    <project path="kernel/oneplus/sm8550-modules" name="kernel_oneplus_sm8550-modules" remote="alpha-devices" revision="alpha-17.0" />
    <project path="kernel/oneplus/sm8550-devicetrees" name="kernel_oneplus_sm8550-devicetrees" remote="alpha-devices" revision="alpha-17.0" />

    <!-- ===================== vendor blobs =====================
         Flattened to alpha-17.0 on 2026-09-15: LOS history dropped, blobs
         re-imported from CPH2585_16.0.5.1002(EX01). astonc keeps a custom LFS
         setup (empty .lfsconfig => the repo's own endpoint, radio/* tracked);
         sm8550-common has no LFS content, matching A16. -->
    <project path="vendor/oneplus/astonc" name="vendor_oneplus_astonc" remote="alpha-gitlab" revision="alpha-17.0" />
    <project path="vendor/oneplus/sm8550-common" name="vendor_oneplus_sm8550-common" remote="alpha-gitlab" revision="alpha-17.0" />

    <!-- ===================== camera =====================
         The OPlus camera and gallery port. astonc device.mk inherits
         camera-vendor.mk outright, so the tree must be here. Its A17 branch
         stays on the private vendor_oplus_camera_17, with the full A16 history
         and every LFS blob, until it goes public on vendor_oplus_camera. -->
    <project path="vendor/oplus/camera" name="vendor_oplus_camera_17" remote="alpha-gitlab" revision="alpha-17.0" />

    <!-- ===================== accessories =====================
         Not ported to A17. fusion is the content-immune ALS ext-port and is the
         highest-risk device item on the rebase — it binds to libsensorservice
         internals. Note astonc device.mk must use inherit-product (not
         -if-exists) for fusion, or a missing tree ships silently.

    <project path="vendor/oneplus/fusion" name="vendor_oneplus_fusion" remote="alpha-gitlab" revision="alpha-17.0" />
    <project path="vendor/oneplus/dolby" name="vendor_oneplus_dolby" remote="alpha-gitlab" revision="alpha-17.0" />
    <project path="vendor/oneplus/ir" name="vendor_oneplus_ir" remote="alpha-gitlab" revision="alpha-17.0" />
    -->

</manifest>
